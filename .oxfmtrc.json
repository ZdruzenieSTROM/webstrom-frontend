{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  "bracketSpacing": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "next-env.d.ts",
    "**/*.{json,jsonc,json5,md,mdx,yml,yaml,toml,css,scss,less,html,graphql,hbs,vue,svelte,astro}"
  ]
}
